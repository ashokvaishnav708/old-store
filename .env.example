# Postgres
DATABASE_URL=postgres://oldstore:oldstore@localhost:5432/oldstore

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally, swap for AWS S3 / Cloudflare R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=listings
S3_ACCESS_KEY_ID=oldstore
S3_SECRET_ACCESS_KEY=oldstore123
# Public base URL used to build image links returned to the client
S3_PUBLIC_URL=http://localhost:9000/listings

# Session cookie encryption key for nuxt-auth-utils (32+ chars). Generate with:
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-character-minimum-secret

# SMTP (password reset emails). Mailpit locally catches everything sent here —
# view it at http://localhost:8025. Swap for a real SMTP provider in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@oldstore.local

# Base URL used to build links in outgoing emails (e.g. password reset)
NUXT_PUBLIC_BASE_URL=http://localhost:3000
